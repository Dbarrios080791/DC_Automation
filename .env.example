# Copia este archivo a .env (ignorado por git) y rellena tus valores.
# El Makefile lo carga automáticamente.

# --- CML (máquina de escritorio) ---
TF_VAR_cml_address=https://192.168.100.5
TF_VAR_cml_username=admin
TF_VAR_cml_password=CHANGE_ME
# Password de laboratorio que se inyecta en el day-0 de todos los nodos
TF_VAR_device_password=CHANGE_ME

# --- NX-OS (Terraform nac-nxos y Ansible) ---
NXOS_USERNAME=admin
NXOS_PASSWORD=CHANGE_ME     # igual a TF_VAR_device_password

# --- ACI (simulador APIC 6.0) ---
ACI_URL=https://192.168.100.50
ACI_USERNAME=admin
ACI_PASSWORD=CHANGE_ME
